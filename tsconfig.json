{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler", // ← バンドラにしないと、モジュール解決ができない
    "skipDefaultLibCheck": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@chakra/*": ["src/demo/components/chakra/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
